# Game-derived and generated data never goes in the repo (personal use only; see docs/RBU_CUSTOM_SONGS.md).
# What stays: scripts/, pocketencore/, installer/, docs/, songs/*/song.json + chart.mid + effects.json, pocketencore.cmd, README.md.

# built songs and work files
out/
work/
stress/
reaper/
songs/*/build/
songs/*/*.bak
songs/.db/

# audio (stems, decoded tracks) and MIDIs from elsewhere
customs/
*.wav
*.mp3
*.flac
*.ogg
*.at3
*.ATM
*.EDAT
*.STR
*.zip

# third-party tools: downloaded by the user (see the Setup page)
at3tool/
mid2rbu/
ATMTool-main/

# per-machine
settings.json
pocketencore/.window/
pocketencore/.running
installer/Output/
__pycache__/
*.pyc
Thumbs.db

# files dropped on the New song page, before the song is created
incoming/
# stems copied into a song folder (copyrighted audio)
songs/*/stems/

# disc files read from the user's own ISO (game data)
cache/
